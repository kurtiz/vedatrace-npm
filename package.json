{
	"name": "vedatrace",
	"description": "Universal JavaScript logging SDK for VedaTrace - type-safe, lightweight, and developer-friendly",
	"version": "0.1.0",
	"scripts": {
		"setup": "rm -rf node_modules && npm i && git init && husky",
		"prepublishOnly": "npm run build",
		"build": "pkgroll --clean-dist",
		"test": "vitest --run",
		"lint": "npx @biomejs/biome check --write",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "bun run build && changeset publish",
		"ci:version": "changeset version",
		"ci:publish": "bun run build && changeset publish"
	},
	"files": [
		"dist"
	],
	"lint-staged": {
		"*.{ts,tsx}": [
			"npm run lint"
		]
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		},
		"./express": {
			"require": {
				"types": "./dist/integrations/express.d.cts",
				"default": "./dist/integrations/express.cjs"
			},
			"import": {
				"types": "./dist/integrations/express.d.mts",
				"default": "./dist/integrations/express.mjs"
			}
		},
		"./next": {
			"require": {
				"types": "./dist/integrations/nextjs.d.cts",
				"default": "./dist/integrations/nextjs.cjs"
			},
			"import": {
				"types": "./dist/integrations/nextjs.d.mts",
				"default": "./dist/integrations/nextjs.mjs"
			}
		},
		"./react": {
			"require": {
				"types": "./dist/integrations/react.d.cts",
				"default": "./dist/integrations/react.cjs"
			},
			"import": {
				"types": "./dist/integrations/react.d.mts",
				"default": "./dist/integrations/react.mjs"
			}
		},
		"./transports": {
			"require": {
				"types": "./dist/transports/index.d.cts",
				"default": "./dist/transports/index.cjs"
			},
			"import": {
				"types": "./dist/transports/index.d.mts",
				"default": "./dist/transports/index.mjs"
			}
		}
	},
	"keywords": [
		"logging",
		"logs",
		"observability",
		"monitoring",
		"typescript",
		"javascript",
		"cloudflare",
		"edge",
		"serverless"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@changesets/cli": "^2.29.8",
		"@vitest/coverage-v8": "^4.0.18",
		"execa": "^9.6.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"pkgroll": "^2.23.0",
		"react": "^19.2.4",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"peerDependencies": {
		"express": "latest",
		"react": ">=16.8.0",
		"@types/express": "^5.0.6",
		"@types/react": "^19.2.13"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"express": {
			"optional": true
		},
		"@types/express": {
			"optional": true
		},
		"@types/react": {
			"optional": true
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yourusername/vedatrace-sdk.git"
	},
	"bugs": {
		"url": "https://github.com/yourusername/vedatrace-sdk/issues"
	},
	"author": "VedaTrace",
	"license": "MIT"
}
